# =============================================================================
# MySQL extra config (mounted at /etc/mysql/conf.d/)
# The base image already configures utf8mb4; this file adds sane timeouts and
# the slow query log.
# =============================================================================

[mysqld]
# Long-running AI character chat can produce slow queries
slow_query_log = 1
long_query_time = 2
log_output = TABLE

# Connection handling
wait_timeout = 600
interactive_timeout = 600
max_allowed_packet = 64M

# Reasonable defaults for 2 vCPU / 4GB DB instance
innodb_log_file_size = 64M
innodb_flush_log_at_trx_commit = 2
