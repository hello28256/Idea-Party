# =============================================================================
# Idea-Party production env (loaded by docker-compose)
# Copy this file to `.env.production` and fill in real values.
#   cp .env.production.example .env.production
# NEVER commit `.env.production` to git.
# =============================================================================

# ---- MySQL ----
# Use a STRONG password. Special characters must be safely quoted in the .env.
MYSQL_ROOT_PASSWORD=ChangeMe_to_a_strong_password_32+_chars
MYSQL_DATABASE=ideaparty

# ---- JWT ----
# Generate with: openssl rand -base64 48
# Must be a Base64-encoded key, 256+ bits when decoded.
JWT_SECRET=ReplaceMeWithOpensslRandBase64Output==
JWT_EXPIRATION=900000

# ---- DeepSeek (LLM) ----
# Get an API key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-replace-with-your-real-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- App ----
# Public URL where users access the app (used for CORS, OAuth callbacks, etc.)
# Examples: https://idea-party.example.com  or  http://1.2.3.4
PUBLIC_BASE_URL=http://localhost
# Override CORS allowed origins (comma-separated). Defaults to PUBLIC_BASE_URL.
# APP_CORS_ALLOWED_ORIGINS=https://idea-party.example.com,https://www.idea-party.example.com

# ---- Default admin (DataLoader seed on first boot) ----
# DataLoader 在全新库（按用户名幂等）创建默认管理员账号。
# Username/password 仅在「该用户名不存在」时被消费一次，BCrypt 哈希后落库。
# 生产环境务必通过环境变量覆盖，避免使用默认值 admin123/admin123。
APP_ADMIN_USERNAME=admin123
APP_ADMIN_PASSWORD=admin123

# ---- Frontend ----
# Host port that maps to the client container's port 80
CLIENT_PORT=80

# ---- Backend JVM tuning (optional) ----
# SERVER_JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Xms256m -Xmx1024m
SERVER_JAVA_OPTS=

# ---- 阿里云 OSS (图片存储) ----
# 桶在华南1(深圳),公共读,前端浏览器直连。
# 注意桶名带横杠: idea-party-uploads(不是 ideaparty-uploads)
# 端点(endpoint)用于后端 SDK 拼桶,域名(bucket domain)用于浏览器 <img src>
ALIYUN_OSS_BUCKET=idea-party-uploads
ALIYUN_OSS_REGION=oss-cn-shenzhen
ALIYUN_OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
ALIYUN_OSS_BUCKET_DOMAIN=https://idea-party-uploads.oss-cn-shenzhen.aliyuncs.com
# 上传到 OSS 的统一前缀(保留 server/uploads 的目录结构,便于 nginx 301 兜底)
ALIYUN_OSS_KEY_PREFIX=uploads/

# ---- 阿里云 STS (前端直传凭证签发) ----
# 用一对 RAM 用户的 AK 调 AssumeRole,角色限定到 oss:PutObject 桶内 uploads/* 前缀。
# 用户必须绑系统策略 AliyunSTSAssumeRoleAccess,角色必须绑自定义策略
# (Action=oss:PutObject, Resource=acs:oss:*:*:idea-party-uploads/uploads/*)。
ALIYUN_STS_ACCESS_KEY_ID=replace-with-ram-user-ak-id
ALIYUN_STS_ACCESS_KEY_SECRET=replace-with-ram-user-ak-secret
ALIYUN_STS_ROLE_ARN=acs:ram::your-account-uid:role/idea-party-uploader
ALIYUN_STS_ROLE_SESSION_NAME=ideaparty-upload
# 临时凭证有效期(秒),范围 [900, 3600];前端拿到即传,传完即弃
ALIYUN_STS_DURATION_SECONDS=3600
