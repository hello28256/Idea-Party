# =============================================================================
# Idea-Party production env (loaded by docker-compose)
# Copy this file to `.env.production` and fill in real values.
#   cp .env.production.example .env.production
# NEVER commit `.env.production` to git.
# =============================================================================

# ---- MySQL ----
# Use a STRONG password. Special characters must be safely quoted in the .env.
MYSQL_ROOT_PASSWORD=ChangeMe_to_a_strong_password_32+_chars
MYSQL_DATABASE=ideaparty

# ---- JWT ----
# Generate with: openssl rand -base64 48
# Must be a Base64-encoded key, 256+ bits when decoded.
JWT_SECRET=ReplaceMeWithOpensslRandBase64Output==
JWT_EXPIRATION=900000

# ---- DeepSeek (LLM) ----
# Get an API key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-replace-with-your-real-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- App ----
# Public URL where users access the app (used for CORS, OAuth callbacks, etc.)
# Examples: https://ideaparty.example.com  or  http://1.2.3.4
PUBLIC_BASE_URL=http://localhost
# Override CORS allowed origins (comma-separated). Defaults to PUBLIC_BASE_URL.
# APP_CORS_ALLOWED_ORIGINS=https://ideaparty.example.com,https://www.ideaparty.example.com

# ---- Frontend ----
# Host port that maps to the client container's port 80
CLIENT_PORT=80

# ---- Backend JVM tuning (optional) ----
# SERVER_JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Xms256m -Xmx1024m
SERVER_JAVA_OPTS=
