# =============================================================================
# Idea-Party deploy config (used by deploy.py)
# Copy this file to `.env.deploy` and fill in real values.
#   cp .env.deploy.example .env.deploy
# NEVER commit `.env.deploy` to git.
# =============================================================================

# ---- Target server ----
# 两种写法二选一：
#   1) 直接写 IP，自动拼接成 user@<ip>
#      DEPLOY_HOST=1.2.3.4
#      DEPLOY_USER=ubuntu
#   2) 写 SSH config alias（推荐 — 密钥路径/用户名/端口都在 ~/.ssh/config 统一管理）
#      DEPLOY_HOST=ideaparty
DEPLOY_HOST=your.cvm.ip.here

# CVM 登录用户名（TencentOS 默认 root，Ubuntu 默认 ubuntu）
DEPLOY_USER=ubuntu

# 本机 SSH 私钥路径
DEPLOY_SSH_KEY=~/.ssh/id_ed25519

# 远程项目目录
DEPLOY_REMOTE_DIR=/opt/ideaparty

# 远程 compose env 文件名（docker compose --env-file）
DEPLOY_REMOTE_ENV_FILE=.env.production
