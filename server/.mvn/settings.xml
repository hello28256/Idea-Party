<?xml version="1.0" encoding="UTF-8"?>
<!--
  Idea-Party Maven settings — Docker build 专用
  强制所有 central 流量走阿里云镜像，避免从 repo.maven.apache.org 直连导致
  国内服务器（腾讯云/阿里云）被国外 CDN 限速而长时间卡在 go-offline。
  host 上的 ~/.m2/settings.xml 不影响 docker build，所以这份必须烤进镜像。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <mirrors>
    <mirror>
      <id>aliyun-public</id>
      <mirrorOf>central</mirrorOf>
      <name>aliyun maven public</name>
      <url>https://maven.aliyun.com/repository/public</url>
    </mirror>
  </mirrors>

  <profiles>
    <profile>
      <id>aliyun-plugins</id>
      <pluginRepositories>
        <pluginRepository>
          <id>aliyun-public</id>
          <url>https://maven.aliyun.com/repository/public</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>aliyun-plugins</activeProfile>
  </activeProfiles>
</settings>
