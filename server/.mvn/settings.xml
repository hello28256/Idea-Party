<?xml version="1.0" encoding="UTF-8"?>
<!--
  Idea-Party Maven settings — Docker build 专用
  强制所有流量走腾讯云 Maven 镜像,避免:
    - 直连 repo.maven.apache.org 被国际出口限速
    - 走阿里云镜像(海外节点慢 4x 于腾讯云)
  host 上的 ~/.m2/settings.xml 不影响 docker build,这份必须烤进镜像。

  只配一个 mirror(腾讯云),不 fallback 到阿里云。
  验证: 腾讯云镜像对常用 deps(Spring Boot / LangChain4j / JJWT / Tika / Aliyun SDK)
  都有,缺包时 build 会明确失败而不是用慢源下载。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <mirrors>
    <mirror>
      <id>tencent-public</id>
      <mirrorOf>*</mirrorOf>
      <name>tencent maven public</name>
      <url>https://mirrors.cloud.tencent.com/nexus/repository/maven-public/</url>
    </mirror>
  </mirrors>

  <profiles>
    <profile>
      <id>tencent-plugins</id>
      <pluginRepositories>
        <pluginRepository>
          <id>tencent-public</id>
          <url>https://mirrors.cloud.tencent.com/nexus/repository/maven-public/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>tencent-plugins</activeProfile>
  </activeProfiles>
</settings>
