{
  "name": "ideaparty-client",
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
    "typecheck:electron": "vue-tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "electron:dev": "cross-env NODE_ENV=development VITE_PORT=5173 vite",
    "electron:build": "vite build && electron-builder --mac --config electron-builder.yml",
    "electron:build:dir": "vite build && electron-builder --mac --dir --config electron-builder.yml",
    "electron:build:win": "vite build && electron-builder --win --config electron-builder.yml",
    "electron:build:win:dir": "vite build && electron-builder --win --dir --config electron-builder.yml",
    "electron:build:all": "vite build && electron-builder -mwl --config electron-builder.yml"
  },
  "dependencies": {
    "axios": "1.16.0",
    "cos-js-sdk-v5": "^1.8.0",
    "esbuild": "^0.28.0",
    "lucide-vue-next": "1.0.0",
    "pinia": "3.0.4",
    "socket.io-client": "4.8.3",
    "vue": "3.5.34",
    "vue-router": "5.0.6"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "22.10.0",
    "@vitejs/plugin-vue": "5.2.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "happy-dom": "^16.8.1",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.11",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.5",
    "vue-tsc": "2.2.0"
  }
}
