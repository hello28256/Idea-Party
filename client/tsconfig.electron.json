{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "types": ["node", "electron"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["electron/**/*.ts", "electron/**/*.d.ts", "src/types/**/*.d.ts"]
}
