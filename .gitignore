# Environment variables (contains secrets)
.env
.env.*
!.env.example
!.env.production.example
!.env.deploy.example

# Frontend
node_modules/
dist/
dist-ssr/
*.local
client/.vite/
client/tsconfig.tsbuildinfo
client/coverage/
client/playwright-report/
client/test-results/
client/.eslintcache

# Backend
server/target/
server/*.jar
server/HELP.md
server/logs/
# 运行时卷目录:默认忽略整个 avatars/* 但保留已知的"权威源"子目录
# (presets / hot-rooms / scenarios / brand),让 deploy.py 能 rsync 这些目录。
# 用 !avatars/<sub>/ 和 !avatars/<sub>/* 两行:第一行让 git 看到目录本身,第二行恢复内部文件。
server/uploads/avatars/**
!server/uploads/avatars/presets/
!server/uploads/avatars/presets/**
!server/uploads/avatars/presets/CREDITS.md
!server/uploads/avatars/hot-rooms/
!server/uploads/avatars/hot-rooms/**
!server/uploads/avatars/hot-rooms/CREDITS.md
!server/uploads/avatars/scenarios/
!server/uploads/avatars/scenarios/**
!server/uploads/avatars/scenarios/CREDITS.md
!server/uploads/avatars/brand/
!server/uploads/avatars/brand/**
# 上面 3 行针对运行时卷目录,源码目录下的场景图另在底部"场景封面目录"段声明
*.class
*.war

# IDE
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Eclipse（项目以 Maven 为主，Eclipse 工程文件属于本地误开 IDE 残留）
.classpath
.factorypath
.project
.settings/
server/bin/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache
.cache/
*.tsbuildinfo

# Planning (personal)
.planning/

# Deploy staging directory (rsync writes script here temporarily)
.deploy-staging/

# Test files
*.mjs

# Python (if used)
__pycache__/
*.pyc
.python-version

# Firebase
.firestore/
.firebase/

# 图片
test*.png
/test*
client/test*.png

# 头像处理临时备份(中心裁剪/缩放前)
server/uploads/avatars/presets/_backup/
# 任何 .bak 备份文件
*.bak
*.bak.*

# OSS 增量上传 manifest(由 deploy.py 现场生成,不入仓)
server/uploads/avatars/.oss-manifest.json

# —— 场景封面目录:允许 22 张正式 scn-*.jpg + CREDITS.md + KEYWORDS.md 进仓
# 但工作脚本/中间产物/_tmp/、old/ 不进
!server/src/main/resources/uploads/avatars/scenarios/
!server/src/main/resources/uploads/avatars/scenarios/*.jpg
!server/src/main/resources/uploads/avatars/scenarios/CREDITS.md
!server/src/main/resources/uploads/avatars/scenarios/KEYWORDS.md
server/src/main/resources/uploads/avatars/scenarios/_tmp/
server/src/main/resources/uploads/avatars/scenarios/old/
